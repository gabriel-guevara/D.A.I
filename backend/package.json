    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "bcryptjs": "^2.4.3",
    "busboy": "1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.13.0"
  }
}
