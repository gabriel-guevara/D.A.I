{
  "name": "dai-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node db/setup.js",
    "db:setup:demo": "node db/setup.js --seed",
    "texto:indexar": "node scripts/indexar-texto.js",
