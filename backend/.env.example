# Copia este archivo a .env y ajusta los valores. NUNCA subas el .env al repositorio.
# Aquí solo hay MARCADORES: los valores reales van en tu .env local o en Render → Environment.
PORT=3000
NODE_ENV=development

# ---------- Entorno (ver src/lib/entorno.js) ----------
# "development" en tu máquina (rama dev de Neon); "production" solo en Render.
APP_ENV=development
# SOLO el host de tu rama dev (sin usuario, contraseña, puerto ni base). Ej.: ep-xxxx.region.aws.neon.tech
# db:setup, db:setup:demo, purgas masivas y npm test se niegan a correr si no coincide con DATABASE_URL.
# En Render NO se define.
DB_HOST_PERMITIDO=localhost

# Conexión a PostgreSQL (en tu máquina: la rama dev de Neon o un PostgreSQL local)
DATABASE_URL=postgres://usuario:clave@localhost:5432/dai

# Firma de tokens: usa una cadena larga y aleatoria (ej: openssl rand -hex 48)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Origen permitido del front (CORS). Con el proxy de Angular no hace falta, pero no estorba.
CORS_ORIGIN=http://localhost:4200

# ---------- Almacenamiento de archivos (ver src/lib/storage.js) ----------
# "local" (backend/.storage, solo desarrollo) o "r2". En producción solo se permite "r2".
STORAGE_DRIVER=local
# Solo con STORAGE_DRIVER=r2. En desarrollo el bucket DEBE terminar en "-dev"; en producción NO.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Tamaño máximo de subida en MB (entero de 1 a 100). Por defecto 20.
MAX_UPLOAD_MB=20

# ---------- 2FA (se usará en la Fase 3) ----------
# Clave para cifrar los secretos TOTP en reposo (AES-256-GCM). Generar con: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# SOLO desarrollo: código 2FA que se acepta si el usuario no tiene secreto TOTP.
# Se ignora cuando NODE_ENV=production. (Se eliminará en la Fase 3.)
MFA_DEV_CODE=123456
